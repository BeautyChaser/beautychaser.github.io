    "katex": "^0.16.47",
    "markdown-it-prism": "^3.0.1",
    "prismjs": "^1.30.0",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "fast-xml-parser": "^5.11.2",
    "markdown-it": "^14.1.1",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
