{
  "compilerOptions": {
    /* 解决报错 2：让 TS 认识 Promise, Async/Await 和现代 API */
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler", /* 或者 "node" */

    /* 解决报错 1：让 TS 认识 @ 符号 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* 其他必要配置 */
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}